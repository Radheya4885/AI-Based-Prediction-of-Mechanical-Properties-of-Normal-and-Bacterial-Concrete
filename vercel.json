{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb"
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/predict",  "dest": "/api/index.py" },
    { "src": "/health",   "dest": "/api/index.py" },
    { "src": "/(.*)",     "dest": "/public/$1" }
  ],
  "outputDirectory": "public"
}
